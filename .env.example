# Copy to .env next to compose.yml. Everything here is optional; without it you get singleplayer only.

# --- Multiplayer relay -------------------------------------------------------------------------------
# The browser can't open TCP connections, so the container relays Minecraft traffic over a WebSocket.
# Protect it with Cloudflare Access (Zero Trust > Settings shows the team domain; the Access app shows the AUD):
CF_TEAM_DOMAIN=
CF_ACCESS_AUD=
PUBLIC_HOST=                 # e.g. mc.example.com, checked against the page's Origin
# ...or, only on a network you trust, run it without login:
# INSECURE_NO_AUTH=1

# Servers players may join (offline-mode servers only), comma separated, no spaces:
#   *                      any public server (LAN/private addresses are always blocked unless listed)
#   host:port              one server
#   name=host:port         a nickname, e.g. smp=my-mc-container:25565 for a server on this machine
ALLOWED_TARGETS=*
# ALLOWED_EMAILS=          extra email allowlist on top of your Access policy
# MAX_CONNECTIONS_PER_USER=3
# IDLE_TIMEOUT_SECONDS=300

# --- Build ------------------------------------------------------------------------------------------
# BUILD_HEAP=6g            memory for the one-time compile; raise to 8g if the log says it ran out
# FORCE_REBUILD=1          rebuild on the next start even if the game is up to date
